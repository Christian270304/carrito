# Copia este archivo como .env para desarrollo local. Nunca subas .env a GitHub.
PORT=3000
NODE_ENV=development
# Solo para probar localmente. Para Render debes utilizar una URL remota de Turso.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# JSON en una sola línea. Sustituye las contraseñas antes de arrancar (mínimo 12 caracteres).
USERS_JSON=[{"username":"christian","password":"CAMBIA-esta-clave-123"},{"username":"familia","password":"CAMBIA-esta-otra-456"}]
